// Shared data types passed from Rust into the UI. Geometry (x/y/width/height)
// comes from KDDockWidgets' C++ layouting engine; everything else (titles,
// colors, which tab is current) is owned by the app.

// One tab in a Group's tab bar.
export struct DockWidgetData {
    unique-name: string,
    title: string,
}

export struct GroupData {
    id: int,
    visible: bool,
    x: length,
    y: length,
    width: length,
    height: length,
    dockwidgets: [DockWidgetData],
    current-index: int,
}

export struct SeparatorData {
    id: int,
    x: length,
    y: length,
    width: length,
    height: length,
    is-vertical: bool,
}

// Where a DockWidget is, see Docking.dock-state().
export struct DockState {
    is-open: bool,
    is-current: bool,
    // Geometry of the hosting Group, including its title and tab bars
    x: length,
    y: length,
    width: length,
    height: length,
}

// One drop indicator icon: already positioned, and already carrying the
// right artwork for its location and whether it's the one the pointer is
// currently over (see kddockwidgets::indicator_image, used by install!()
// to build these -- Slint's @image-url can't pick a file by a
// runtime-computed name, so the Rust side decodes the right one itself
// instead of this side choosing between several).
export struct IndicatorData {
    x: length,
    y: length,
    image: image,
}

// Geometry -- and, for the ghost, image -- for an in-progress drag.
// `active` being false means no drag is in progress; every other field is
// then meaningless and DropIndicators (ui/dropindicators.slint) draws
// nothing.
export struct DragData {
    active: bool,
    ghost-x: length,
    ghost-y: length,
    ghost-width: length,
    ghost-height: length,
    ghost-image: image,
    rubber-band-visible: bool,
    rubber-band-x: length,
    rubber-band-y: length,
    rubber-band-width: length,
    rubber-band-height: length,
}

// Sizes of a Group's chrome. Shared by Group, which draws it, and
// DockWidget, which positions its content below it.
export global GroupMetrics {
    out property <length> border-width: 1px;
    out property <length> title-bar-height: 24px;
    out property <length> tab-bar-height: 22px;
    out property <length> header-height: border-width + title-bar-height + tab-bar-height;
}

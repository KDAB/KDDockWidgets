// The dock widget's own content. For now it's just a colored rectangle;
// arbitrary user content is a later step.
export component DockWidget inherits Rectangle {
    in property <string> title;
    in property <color> dock-color: #808080;

    // Hardcoded for now, per the current milestone. This is also the
    // minimum width the Rust side reports to the layouting engine for the
    // Group hosting this dock widget, so a Group is never squeezed below it.
    width: 100px;

    background: dock-color;
}

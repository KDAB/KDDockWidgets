import { Group } from "group.slint";
import { Separator } from "separator.slint";
import { DropIndicators } from "dropindicators.slint";
import { Docking } from "docking.slint";

// Hosts every Group, the app's DockWidgets (as children), and the
// Separators between Groups. This component doesn't compute any layout
// itself: it's a "dumb" renderer for whatever geometry KDDockWidgets' C++
// layouting engine has worked out, which Rust pushes into Docking.groups and
// Docking.separators after every change.
export component DropArea inherits Rectangle {
    background: white;

    changed width => { Docking.resized(root.width, root.height); }
    changed height => { Docking.resized(root.width, root.height); }

    // Reports the size Rust missed: the callbacks above only fire on later
    // changes, and a plain `init` would run before Rust installed them (same
    // reason as DockWidget's registration, see dockwidget.slint).
    if Docking.ready: Rectangle {
        width: 0px;
        height: 0px;
        init => { Docking.resized(root.width, root.height); }
    }

    for g in Docking.groups: Group {
        x: g.x;
        y: g.y;
        width: g.width;
        height: g.height;
        visible: g.visible;
        data: g;
        close-requested(name) => { Docking.close-requested(name); }
        current-changed(name) => { Docking.current-changed(name); }

        // Group/TitleBar report window-absolute positions (they don't know
        // where the enclosing DropArea is); this is the one place that both
        // forwards them and knows root.absolute-position, so it converts
        // to DropArea-local before handing them to Docking -- the same
        // space GroupData/SeparatorData geometry (above) is already in.
        drag-started(name, whole, x, y) => {
            Docking.drag-started(name, whole, x - root.absolute-position.x, y - root.absolute-position.y);
        }
        drag-moved(x, y) => {
            Docking.drag-moved(x - root.absolute-position.x, y - root.absolute-position.y);
        }
        drag-ended(x, y) => {
            Docking.drag-ended(x - root.absolute-position.x, y - root.absolute-position.y);
        }
    }

    // DockWidgets, drawn over their Group
    @children

    for s in Docking.separators: Separator {
        x: s.x;
        y: s.y;
        width: s.width;
        height: s.height;
        is-vertical: s.is-vertical;
        id: s.id;
        pressed(id) => { Docking.separator-pressed(id); }
        released(id) => { Docking.separator-released(id); }
        moved(id, dx, dy) => { Docking.separator-moved(id, dx, dy); }
    }

    // On top of everything: indicators, rubber band, ghost image.
    DropIndicators { }
}

import { TitleBar } from "titlebar.slint";
import { DockWidget } from "dockwidget.slint";
import { GroupData } from "types.slint";

// A Group: a TitleBar on top, a row of tabs below it, and the content of
// whichever tab is current. Each tab is one DockWidget.
//
// This maps to a KDDockWidgets::Core::Item on the C++ side: `data`'s
// geometry (x/y/width/height/visible) comes straight from the layouting
// engine, computed relative to the enclosing DropArea. Everything else
// (titles, colors, which tab is current) is owned by the app.
export component Group inherits Rectangle {
    in property <GroupData> data;

    // index of the tab that was closed, within data.dockwidgets
    callback close-requested(index: int);
    // index of the tab that was clicked, within data.dockwidgets
    callback current-changed(index: int);

    background: #2b2b2b;
    border-width: 1px;
    border-color: #444444;

    VerticalLayout {
        TitleBar {
            title: data.dockwidgets[data.current-index].title;
            close-clicked => { root.close-requested(data.current-index); }
        }

        Rectangle {
            // tab bar
            height: 22px;
            background: #1c1c1c;

            HorizontalLayout {
                for dw[i] in data.dockwidgets: TouchArea {
                    clicked => { root.current-changed(i); }

                    Rectangle {
                        background: i == data.current-index ? #3a3a3a : transparent;

                        Text {
                            text: dw.title;
                            color: white;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }

        Rectangle {
            // tab content: every dock widget is instantiated, only the
            // current one is shown. Simpler than tearing down/rebuilding on
            // every tab switch, and there's no per-tab state to worry about
            // losing yet.
            for dw[i] in data.dockwidgets: DockWidget {
                x: 0;
                y: 0;
                height: 100%;
                visible: i == data.current-index;
                title: dw.title;
                dock-color: dw.color;
            }
        }
    }
}

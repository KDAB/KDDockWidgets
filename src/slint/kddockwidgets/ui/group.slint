import { TitleBar } from "titlebar.slint";
import { GroupData, GroupMetrics } from "types.slint";

// A Group: a TitleBar on top and a row of tabs below it. Each tab is one
// DockWidget. This only draws the chrome: the DockWidgets' content isn't
// inside the Group, it positions itself over the Group's content area (see
// dockwidget.slint).
//
// This maps to a KDDockWidgets::Core::Item on the C++ side: `data`'s
// geometry (x/y/width/height/visible) comes straight from the layouting
// engine, computed relative to the enclosing DropArea. Everything else
// (titles, which tab is current) is tracked on the Rust side.
export component Group inherits Rectangle {
    in property <GroupData> data;

    callback close-requested(unique-name: string);
    callback current-changed(unique-name: string);

    background: #2b2b2b;
    border-width: GroupMetrics.border-width;
    border-color: #444444;

    VerticalLayout {
        padding: GroupMetrics.border-width;

        TitleBar {
            height: GroupMetrics.title-bar-height;
            title: data.dockwidgets[data.current-index].title;
            close-clicked => { root.close-requested(data.dockwidgets[data.current-index].unique-name); }
        }

        Rectangle {
            // tab bar
            height: GroupMetrics.tab-bar-height;
            background: #1c1c1c;

            HorizontalLayout {
                for dw[i] in data.dockwidgets: TouchArea {
                    clicked => { root.current-changed(dw.unique-name); }

                    Rectangle {
                        background: i == data.current-index ? #3a3a3a : transparent;

                        Text {
                            text: dw.title;
                            color: white;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }

        // content area, covered by the current DockWidget
        Rectangle { }
    }
}

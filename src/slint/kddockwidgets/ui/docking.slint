import { DockState, GroupData, SeparatorData } from "types.slint";

// The single channel between the Slint components and the Rust side
// (kddockwidgets::DockingArea). Internal: an app only has to re-export it
// from its main .slint file, `export { Docking } from "@kddockwidgets";`, so
// that Slint generates Rust for it; kddockwidgets::install!() then fills in
// everything below.
export global Docking {
    // Set by Rust once it has installed the callbacks below. DockWidgets
    // only register themselves after that, see DockWidget.
    in property <bool> ready;

    // Bumped by Rust after every layout change. It's passed to dock-state()
    // purely so that its callers re-evaluate: Slint doesn't track
    // dependencies through callbacks.
    in property <int> revision;

    in property <[GroupData]> groups;
    in property <[SeparatorData]> separators;

    // min-width/min-height include the Group's chrome.
    callback register(unique-name: string, title: string, min-width: length, min-height: length);
    callback title-changed(unique-name: string, title: string);
    callback close-requested(unique-name: string);
    callback current-changed(unique-name: string);
    callback resized(width: length, height: length);

    callback separator-pressed(id: int);
    callback separator-released(id: int);
    callback separator-moved(id: int, dx: length, dy: length);

    pure callback dock-state(unique-name: string, revision: int) -> DockState;
}
